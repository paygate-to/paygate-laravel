{
    "name": "paygate-to/paygate-laravel",
    "description": "Laravel integration for PayGate.to: card and crypto payments without KYC, instant payouts to your own wallet, and a middleware that verifies signed callbacks.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "paygate",
        "paygate.to",
        "payments",
        "payment gateway",
        "crypto",
        "bitcoin",
        "usdc",
        "credit card",
        "no kyc"
    ],
    "homepage": "https://paygate.to/docs/sdk/php/#laravel",
    "support": {
        "docs": "https://paygate.to/docs/sdk/php/#laravel",
        "source": "https://github.com/paygate-to/paygate-laravel",
        "issues": "https://github.com/paygate-to/paygate-laravel/issues"
    },
    "require": {
        "php": ">=8.1",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0",
        "illuminate/routing": "^10.0 || ^11.0 || ^12.0",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0",
        "paygate-to/paygate-php": "^1.0"
    },
    "require-dev": {
        "laravel/framework": "^11.0 || ^12.0",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "PayGate\\Laravel\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "PayGate\\Laravel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "PayGate\\Laravel\\PayGateServiceProvider"
            ],
            "aliases": {
                "PayGate": "PayGate\\Laravel\\Facades\\PayGate"
            }
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
